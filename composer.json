{
    "name": "mimon/kafka-logger",
    "description": "Standardized Enterprise Kafka Log Payload Builder, Schema Validator & Facade for Laravel Microservices",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mimon"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "mateusjunges/laravel-kafka": "^2.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Mimon\\KafkaLogger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mimon\\KafkaLogger\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mimon\\KafkaLogger\\Providers\\KafkaLoggerServiceProvider"
            ],
            "aliases": {
                "KafkaLogger": "Mimon\\KafkaLogger\\Facades\\KafkaLogger"
            }
        }
    }
}